# Canonical site. Caddy issues the Let's Encrypt certificate automatically once DNS points here.
poeracerewards.com {
    encode zstd gzip
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Serve static files directly (more reliable than proxying many small requests
    # through the Python server).
    # Item icons. The server appends ?v=<file mtime> to icon URLs it hands out, so those
    # can be cached long-term; unversioned requests revalidate (cheap 304 via ETag).
    @iconsVersioned {
        path /assets/icons/*
        query v=*
    }
    handle @iconsVersioned {
        root * /opt/poe-market-flips/web
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }

    @icons path /assets/icons/*
    handle @icons {
        root * /opt/poe-market-flips/web
        file_server
        header Cache-Control "no-cache"
    }

    # JS/CSS URLs are unversioned (native ES modules import each other by plain path), so
    # browsers must revalidate them (cheap 304 via ETag) or they keep stale code after a deploy.
    @code path /css/* /js/*
    handle @code {
        root * /opt/poe-market-flips/web
        file_server
        header Cache-Control "no-cache"
    }

    @static path /assets/* /favicon* /robots.txt /sitemap.xml
    handle @static {
        root * /opt/poe-market-flips/web
        file_server
        header Cache-Control "public, max-age=604800, immutable"
    }

    # Everything else (HTML + API) goes to the app.
    reverse_proxy 127.0.0.1:8080
}

# www and the old sslip.io hostname permanently redirect to the canonical domain.
www.poeracerewards.com, 178.104.113.149.sslip.io {
    redir https://poeracerewards.com{uri} permanent
}
